{
  "name": "@local/content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider registry and local video-model adapters for batch content production.",
  "keywords": ["dsh", "content", "video", "短视频", "内容生产"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4 <0.3.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
